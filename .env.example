# Infrys Security Technologies — Environment Variables Example
# Copy this file to .env.local for local development or configure in your hosting provider.

# Resend HTTP API key for /api/contact automated email delivery (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Destination inbox for enterprise security enquiries (defaults to info@infrys.com)
CONTACT_TO_EMAIL=info@infrys.com

# Verified sender address in Resend (must match your verified domain in production)
CONTACT_FROM_EMAIL="Infrys Security Website <noreply@infrys.com>"

